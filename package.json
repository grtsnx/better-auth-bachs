{
  "name": "better-auth-bachs",
  "version": "0.5.1",
  "description": "Production-ready Bachs billing plugin for Better Auth. Built on the official @bachs/sdk — checkout, subscriptions, org billing, payments, portal, and secure webhooks.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Greatness Abolade",
    "url": "https://github.com/grtsnx"
  },
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "bachs",
    "billing",
    "checkout",
    "subscriptions",
    "payments",
    "saas"
  ],
  "homepage": "https://github.com/grtsnx/better-auth-bachs#readme",
  "bugs": {
    "url": "https://github.com/grtsnx/better-auth-bachs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grtsnx/better-auth-bachs.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@bachs/sdk": "^2.0.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@better-auth/core": ">=1.4.0",
    "better-auth": ">=1.4.0"
  },
  "devDependencies": {
    "@better-auth/core": "^1.4.0",
    "@types/node": "^24.0.0",
    "better-auth": "^1.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.14"
}
